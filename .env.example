# Copy to .env and fill in. Never commit the real .env file.

# --- Script generation (LLM) ---
ANTHROPIC_API_KEY=

# --- Text-to-speech (narration) ---
# Pick one and set TTS_PROVIDER accordingly. ElevenLabs is the industry default
# for faceless channels (best prosody/emotion control); Higgsfield's
# text2speech_v2 is already available in this workspace via MCP as a
# zero-extra-setup fallback (see docs/04-production-pipeline.md).
TTS_PROVIDER=elevenlabs   # elevenlabs | higgsfield
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Stock visuals (real San Diego footage/photos) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Optional: Unsplash for stills
UNSPLASH_ACCESS_KEY=

# --- Captions ---
# faster-whisper runs locally, no key needed. Leave as-is unless you swap providers.
WHISPER_MODEL_SIZE=small

# --- Publishing: YouTube Data API v3 ---
YOUTUBE_CLIENT_SECRETS_FILE=config/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=config/youtube_token.json
YOUTUBE_CHANNEL_ID=

# --- Publishing: Instagram Graph API (requires FB Business + IG Professional account) ---
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
FB_APP_ID=
FB_APP_SECRET=

# --- Storage for publishable media (IG Graph API requires a public URL) ---
# e.g. an S3/Cloudflare R2 bucket or Google Drive with public sharing links
MEDIA_HOST_PROVIDER=              # s3 | r2 | gdrive
MEDIA_HOST_BUCKET=
MEDIA_HOST_PUBLIC_BASE_URL=

# --- Notifications (optional, for pipeline run alerts / approval requests) ---
SLACK_WEBHOOK_URL=
NOTIFY_EMAIL=
